// Relational schema per the reviewed design record (docs/design/data-model.md,
// WU-M3a-1). Models land migration-by-migration following the design's §13 list;
// everything Prisma cannot express (citext extension, partial/expression unique
// indexes, CHECKs, constraint triggers) lives as raw SQL inside the same
// migration directory — see each migration.sql.
// Prisma 7 layout: the connection URL lives in prisma.config.ts (CLI) and in the
// driver adapter passed to PrismaClient (runtime); DATABASE_URL is the single knob.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums (design §3) ────────────────────────────────────────────────────────

// E1 — decision C8: legacy's 18-locale enum shrinks to {ro,en}.
enum Locale {
  ro
  en

  @@map("locale")
}

// E2 — verbatim (kebab→snake) from legacy/lib/models/token.js:7.
enum TokenScope {
  password_reset
  email_validation

  @@map("token_scope")
}

// E12 — decision G-10 verification ladder; ordered, mirrors e2e/fixtures/users.ts.
enum VerificationStage {
  stage1_email
  stage2_phone
  stage3_eid

  @@map("verification_stage")
}

// E3 — verbatim legacy/lib/models/forum/roles.js:7-13. `owner` is NOT a role
// (lives on Forum.ownerId — FR-1); `moderator` (config-gated, default off) is
// omitted until the product decides the flag survives (additive later).
enum ForumRole {
  admin
  collaborator
  author
  participant

  @@map("forum_role")
}

// E4 — verbatim legacy/lib/models/forum/visibilities.js:5-10 (FR-6).
enum ForumVisibility {
  private
  closed
  public
  collaborative

  @@map("forum_visibility")
}

// E13 — the five discriminators at legacy/lib/models/forum/topics-attrs.js:17-39.
enum TopicAttrKind {
  number
  string
  long_string
  enum
  boolean

  @@map("topic_attr_kind")
}

// E5 — legacy/lib/models/topic.js:73 MINUS the '' member: legacy's "no action"
// empty string becomes Topic.votingMethod IS NULL. Whether "no method" survives
// as NULL or is subsumed by content_type='debate' is open Q-7 (C4) — the schema
// supports both, so Q-7's resolution costs no migration.
enum VotingMethod {
  vote
  poll
  cause
  slider
  hierarchy

  @@map("voting_method")
}

// E6 — decision C4 / plan WU-M3b-9. No legacy analogue.
enum ContentType {
  debate
  proposal
  poll

  @@map("content_type")
}

// E7 — decision C3/N11. Legacy's closed state is DERIVED from closingAt
// passing (TL-8); see CHECK C1 (raw SQL, topics migration) for how the two
// coexist.
enum Lifecycle {
  open
  closed
  outcome_published

  @@map("lifecycle")
}

// E14 — the nine keys of legacy/lib/tags-images/index.js:5-43 (AD-5's "fixed
// 9-image dictionary"; legacy enum at legacy/lib/models/tag.js:16).
enum TagImage {
  arts
  scale
  police
  signs
  transportation
  people
  parks
  agora
  internet

  @@map("tag_image")
}

// ── WU-M3a-2: identity core (design §2 M1/M2/M7/M8/M27) ─────────────────────
//
// Deliberately absent, pending owner ratification (no placeholders, no guesses):
//   - OD-11 age-gate storage (design M6 recommends `ageAttestedAt`, not ratified)
//   - OD-12 phone storage (`VerificationEvent`, design M29 — later migration)
//   - `ConsentRecord` (M28) + `consent_purpose` (E16) — lands with its own WU.
// No `staff` column by design (M5 — RBAC is WU-M4-7).

model User {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName         String?           @db.VarChar(100)
  lastName          String?           @db.VarChar(100)
  // U1: real UNIQUE on citext — legacy's index was NOT unique (plan §2.4 row 6,
  // AU-4); citext makes AU-7 case-insensitivity structural.
  email             String            @unique @db.Citext
  emailValidated    Boolean           @default(false)
  locale            Locale            @default(ro)
  passwordHash      String?
  profilePictureUrl String?
  disabledAt        DateTime?         @db.Timestamptz(6)
  // §11: current stage, denormalized; the evidence trail (VerificationEvent)
  // arrives in a later migration once OD-12 is ratified.
  verificationStage VerificationStage @default(stage1_email)
  // M2: exactly two notification types end to end (SE-4, P-15, COR-21).
  notifyReplies     Boolean           @default(true)
  notifyNewTopic    Boolean           @default(false)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @db.Timestamptz(6)

  sessions         Session[]
  tokens           Token[]
  ownedForums      Forum[]
  forumPermissions ForumPermission[]
  authoredTopics   Topic[]
}

// M8: server-side session rows make sign-out (AU-9), revoke-all and erasure
// real operations instead of cookie-expiry hopes.
model Session {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  // U25: session fixation hygiene.
  tokenHash Bytes     @unique
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)

  // F1: pure identity artifact — dies with the account.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// M7: tokenHash is sha-256 of the secret (the secret itself is never stored);
// single-use = the consuming transaction DELETEs the row (AU-6/AU-12).
// The only sanctioned lookup is WHERE tokenHash=$1 AND scope=$2 AND
// expiresAt > now() — a repository contract (M4); a schema cannot force a
// WHERE clause (design §14, SEC-1/SEC-2).
model Token {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String     @db.Uuid
  scope     TokenScope
  // U2: forgery-by-collision; makes "consume exactly once" an atomic DELETE.
  tokenHash Bytes      @unique
  // SEC-3: legacy tokens lived forever — the field cannot be omitted here.
  expiresAt DateTime   @db.Timestamptz(6)
  // jsonb allow-list entry (design §6): request forensics, zod-parsed at the
  // boundary, retention bounded by expiresAt + cleanup job.
  meta      Json?
  createdAt DateTime   @default(now()) @db.Timestamptz(6)

  // F1: pure identity artifact — dies with the account.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // P-5 delete-then-create per scope; the expiry cleanup job (SEC-3).
  @@index([userId, scope])
  @@index([expiresAt])
}

// M27: the table IS the email whitelist — legacy's single-member `type` enum
// is dropped. No FK to User on purpose; erasure deletes the row explicitly
// (design §5, N8).
model Whitelist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // U21: trivial hygiene; citext for the same AU-7 reason as User.email.
  email     String   @unique @db.Citext
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

// ── WU-M3a-3: forums + permissions (design §2 M9/M10/M11) ────────────────────
//
// Raw SQL in the same migration (Prisma cannot express these):
//   U3  — partial unique index forum_name_live ON lower(name) WHERE deletedAt
//         IS NULL (kills DI-4, the find-then-save race; P-9: deletion frees
//         the name).
//   C8  — name format CHECK (FR-4) + reserved-name CHECK (verbatim from
//         legacy/lib/models/forum/reserved-names.js).
//   C9  — summary ≤ 300 INCLUSIVE (COR-12) + "a live forum always has an
//         owner" (C9b, pairs with F3's SET NULL).
//   T2  — forum_permission_not_owner trigger (FR-8's
//         FORUM_OWNER_CANT_HAVE_ANOTHER_ROLE — cross-table, so not a CHECK).

// M9: Forum core. Tag is NOT here — the design's migration list (§13) lands it
// with topics (migration 3), because Topic.tagId is the FK that needs it.
model Forum {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Uniqueness is the raw partial index U3, not a Prisma @unique — soft-deleted
  // rows must free the name (P-9).
  name       String
  title      String
  summary    String?
  coverUrl   String?
  // F3: SET NULL + C9b — a forum outlives its founder, but a LIVE forum
  // without an owner is unadministrable; erasure must soft-delete first.
  ownerId    String?         @db.Uuid
  visibility ForumVisibility @default(public)
  // FR-10/P-9: forum deletion is soft.
  deletedAt  DateTime?       @db.Timestamptz(6)
  createdAt  DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime        @default(now()) @updatedAt @db.Timestamptz(6)

  owner       User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  permissions ForumPermission[]
  topicAttrs  ForumTopicAttr[]
  topics      Topic[]

  // Added by the WU-M3a-3 review (lands with the topics migration): Postgres
  // does not index FK columns, and every erasure fan-out (design §5) would
  // seq-scan Forum on ownerId without this.
  @@index([ownerId])
}

// M10: legacy's embedded permissions[] array becomes a table. One permission
// per user per forum (U4 — FR-8/P-8: a new grant is an upsert, never a second
// row); "owner can never hold a role" is trigger T2 (raw SQL).
model ForumPermission {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  forumId   String    @db.Uuid
  userId    String    @db.Uuid
  role      ForumRole
  grantedAt DateTime  @default(now()) @db.Timestamptz(6)

  // F4: a role grant is a pure identity↔forum edge; meaningless after erasure.
  forum Forum @relation(fields: [forumId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([forumId, userId])
  // §4.4: erasure fan-out + settings surfaces.
  @@index([userId])
}

// M11: the Mongoose discriminator union (Number/String/LongString/Enum/Boolean)
// is a tagged union — kind + nullable bounds + an option child table. Feeds the
// topics-CSV columns (AD-6). Not jsonb.
model ForumTopicAttr {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  forumId     String        @db.Uuid
  name        String        @db.VarChar(32)
  title       String        @db.VarChar(128)
  description String?       @db.VarChar(256)
  mandatory   Boolean       @default(false)
  kind        TopicAttrKind
  min         Int?
  max         Int?

  // F9: pure content child — lives and dies with its forum.
  forum      Forum                  @relation(fields: [forumId], references: [id], onDelete: Cascade)
  options    ForumTopicAttrOption[]
  attrValues TopicAttrValue[]

  // U13: attr names are column headers in the CSV (AD-6) — duplicates would be
  // ambiguous columns.
  @@unique([forumId, name])
}

// M11 child: option set for kind = 'enum'.
model ForumTopicAttrOption {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attrId String @db.Uuid
  name   String @db.VarChar(128)
  title  String @db.VarChar(128)

  attr ForumTopicAttr @relation(fields: [attrId], references: [id], onDelete: Cascade)

  // U13b — added 21.08.2026 by the WU-M3a-3 review: duplicate option names
  // inserted freely, the same CSV/dropdown ambiguity U13 prevents, one level
  // down. Additive; lands with the topics migration (design §4.1 U13b).
  @@unique([attrId, name])
}

// ── WU-M3a-4: topics + tags (design §2 M13–M19, M25; migration 3 of §13) ─────
//
// Raw SQL in the same migration (design marks these raw):
//   C1  — the two outcome-declaration CHECKs on Topic (C3/N11 + the TL-8
//         reading: the declaration must exist before closingAt may be set).
//   U7  — UNIQUE (id, votingMethod) on Topic: FK target for migration 4's
//         composite FK Vote(topicId, method) → Topic(id, votingMethod).
//   U11 — UNIQUE (topicId, id) on TopicOption: FK target for migration 4's
//         Vote(topicId, pollOptionId) → TopicOption(topicId, id).
//   plus the mediaTitle length CHECK (COR-11, M13) and the Tag hex-color
//   CHECK (M25) — CHECKs are inexpressible in Prisma.
// DEFERRED to migration 4+ (design §13): Vote, VoteRanking, TallyCounter,
// AuditEntry, ConsultationKeyRef (references Topic, but belongs to the
// votes+audit unit — OD-1/OD-5 cluster), trigger T6 (method/option freeze —
// needs Vote to exist), comments, notifications, RLS (OD-4).

// M25: platform-global tag — NO forumId (AD-5; per-forum tags are open Q-11).
// No delete route exists for anyone (P-16) — backed by ON DELETE RESTRICT
// from Topic.tagId (F8).
model Tag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // U5: P-12 dedupe-by-slug (the legacy `hash`, tag.js:13,25). COR-18
  // (rename never regenerates the slug) is an app-layer rule for WU-M4-15.
  slug      String   @unique
  name      String   @db.VarChar(50)
  // Hex format is the raw CHECK tag_color_hex (legacy tag.js:15 +
  // legacy/lib/regexps:5).
  color     String?
  image     TagImage @default(arts)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  topics Topic[]
}

// M13/M14/M18/M19: Topic core. forumId is NOT NULL — legacy's was optional
// (topic.js:52); the relational model closes that hole. The legacy `title`
// virtual (COR-1, always undefined) and `content` virtual (COR-2, dead code)
// are NOT ported — the display title IS mediaTitle (TL-9); no computed title
// exists here. `topicId` (dead import residue) and `tags: [String]`
// (duplicates the tag ref) are dropped.
model Topic {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  forumId             String            @db.Uuid
  // Was legacy `owner` (topic.js:53). F6: SET NULL — published deliberation
  // content is the community's record; attribution is the personal data.
  authorId            String?           @db.Uuid
  // TL-5: a tag is mandatory at creation (topic.js:54).
  tagId               String            @db.Uuid
  slug                String
  // Display title everywhere (TL-9). Length CHECK is raw SQL (COR-11: the
  // single limit constant lives in packages/shared at WU-M3b; the DB CHECK
  // mirrors its recommended 200 — the user-visible form limit).
  mediaTitle          String
  // Display strings (legacy author/authorUrl, topic.js:58-63).
  externalAuthor      String?           @db.VarChar(100)
  externalAuthorUrl   String?           @db.VarChar(250)
  source              String?           @db.VarChar(250)
  coverUrl            String?           @db.VarChar(250)
  // M14: NULL = legacy '' ("no action", pending Q-7). U7 (raw) makes
  // (id, votingMethod) an FK target so a vote's method can never disagree
  // with its topic's method (migration 4).
  votingMethod        VotingMethod?
  contentType         ContentType
  // M18: lifecycle + outcome declaration; CHECK C1 (raw) forces the
  // declaration whenever the topic is closed OR closingAt is set.
  lifecycle           Lifecycle         @default(open)
  outcomeDeclaration  String?
  // M19 (G-10): per-consultation verification requirement; resolves the
  // modelling half of Q-17.
  requiredStageToVote VerificationStage @default(stage2_phone)
  // TL-8: "closed" is derived from closingAt passing.
  closingAt           DateTime?         @db.Timestamptz(6)
  // TL-6/TL-7: draft = publishedAt NULL.
  publishedAt         DateTime?         @db.Timestamptz(6)
  // Legacy soft delete (topic.js:81).
  deletedAt           DateTime?         @db.Timestamptz(6)
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime          @default(now()) @updatedAt @db.Timestamptz(6)

  // F7: RESTRICT — forum deletion is soft (P-9); a hard purge must be a
  // deliberate future transaction, never an accidental cascade.
  forum  Forum @relation(fields: [forumId], references: [id], onDelete: Restrict)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  // F8: RESTRICT — no tag delete exists (P-16); even a rogue admin query
  // cannot orphan topics.
  tag    Tag   @relation(fields: [tagId], references: [id], onDelete: Restrict)

  clauses    Clause[]
  links      TopicLink[]
  options    TopicOption[]
  attrValues TopicAttrValue[]

  // U6: slug-addressed URLs without cross-forum collisions (plan §2.4).
  @@unique([forumId, slug])
  // §4.4: public listing = published-only per forum (TL-7); admin
  // draft-inclusive list (AD-3). Legacy had NO forum index at all.
  @@index([forumId, publishedAt])
  // §4.4: closed-state derivation and closing sweeps (TL-8).
  @@index([closingAt])
  // §4.4: tag filtering (J9; legacy topic.js:92).
  @@index([tagId])
}

// M15: embedded ParagraphSchema → child table. U8 replaces per-serialization
// re-sorting (TL-9) with an ordered-by-construction child table (plan §2.4
// row 2). Sanitization is a write+read pipeline concern, not schema.
model Clause {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topicId  String  @db.Uuid
  position Int
  markup   String?
  empty    Boolean @default(false)

  // F9: pure content child — lives and dies with its topic.
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  // U8: clause order is stored order, not per-read sort (TL-9).
  @@unique([topicId, position])
}

// M16: embedded LinkSchema → table. Trivial.
model TopicLink {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topicId  String  @db.Uuid
  text     String?
  url      String? @db.VarChar(250)
  position Int

  // F9: pure content child.
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

// M14: the immutable option set for poll/hierarchy topics — separated from
// derived tallies (TallyCounter, migration 4) so DI-7's shape mutation is
// inexpressible. "Options mandatory at creation" (TL-4) is an API-layer rule
// (design §12); the freeze trigger T6 lands with Vote (migration 4).
model TopicOption {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topicId  String @db.Uuid
  position Int
  label    String

  // F9: the cascade exists for a deliberate hard purge only; F13's RESTRICT
  // from VoteRanking (migration 4) protects options with recorded rankings.
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  // U9/U10: option sets are well-ordered and duplicate-free (TL-4, VO-7/VO-12).
  @@unique([topicId, position])
  @@unique([topicId, label])
}

// M17: legacy Topic.attrs (Mixed) → typed rows keyed by the forum's attr
// definitions (M11); surfaces in the topics CSV (AD-6). Storing them as jsonb
// would re-create the blob the CSV round-trip has to parse. Typed per-kind
// validation happens against ForumTopicAttr.kind at the boundary.
model TopicAttrValue {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topicId String @db.Uuid
  attrId  String @db.Uuid
  value   String

  // F9: pure content children.
  topic Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  attr  ForumTopicAttr @relation(fields: [attrId], references: [id], onDelete: Cascade)

  // U12: one value per attr per topic (CSV round-trip, AD-6).
  @@unique([topicId, attrId])
}

{
  "name": "@dosrevival/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Greenfield TypeScript rebuild of a civic-participation platform (hard fork of DemocracyOS, GPL-3.0). Temporary scope @dosrevival/* until the brand rename at WU-M2-6.",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "oxlint --deny-warnings",
    "format": "biome format --write .",
    "format:check": "biome ci ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "oxlint": "^1.69.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}

# Copy to .env.local (never committed) and set real values.
# DATABASE_URL is the ONLY database interface this repo knows (plan §4.1):
#   Path A (Docker):        docker compose --env-file .env.local -f docker-compose.dev.yml up -d db
#   Path B (native/hosted): point DATABASE_URL at any reachable PostgreSQL 16+.
# The Prisma CLI reads packages/server/.env — put DATABASE_URL there too (also never committed).
POSTGRES_PASSWORD=change-me-to-a-strong-password
DATABASE_URL=postgresql://dosrevival:change-me-to-a-strong-password@127.0.0.1:5432/dosrevival_dev
